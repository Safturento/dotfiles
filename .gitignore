# Font binaries — too big for git, extracted from zips on-demand by install.sh.
# Use ** so the patterns also match extracted families in fonts/<name>/ subdirs.
fonts

# Local-only overrides (kept out of the public repo)
*.local
*.local.*

# OS / editor cruft
.DS_Store
*~
*.swp

# Cross-session reminder queue — local-only. Reminders must survive branch
# switches and we never reference them from git history, so their content stays
# untracked. README + archive/.gitkeep stay tracked so the dirs exist on a fresh
# checkout (the ~/.claude/reminders symlink would dangle otherwise).
claude/reminders/*.md
!claude/reminders/README.md
claude/reminders/archive/*.md
